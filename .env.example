# Copy this to .env and fill in what you need. .env is git-ignored, refused by
# the request handler, kept out of the container image, and redacted out of
# every log line — but it is still a file with keys in it, so treat it like one.
#
#   cp .env.example .env
#
# A real environment variable always wins over this file, so a shell export
# and Cloud Run's own environment both work without touching it. NODERELS_*
# is still read as an alias for COGNIX_* everywhere.
#
# Nothing here is required. With none of it set the app runs in local mode and
# draws maps with the offline composer.

# ---------------------------------------------------------------- the gateway
# The model key. Server-side only: there is no default in the source, and the
# browser never sees it. Without one the app still runs and still draws maps.
COGNIX_KEY=sk-your-gateway-key-here

# --------------------------------------------------------------- where it runs
# Defaults. 127.0.0.1 is deliberate — binding wider makes a process that holds
# an API key reachable from the rest of the network, and serve.py says so.
# Cloud Run sets PORT itself and serve.py reads it unprefixed.
COGNIX_HOST=127.0.0.1
COGNIX_PORT=8778
COGNIX_BASE=https://api.justwoker.icu

# ------------------------------------------------------------------- accounts
# These five turn on cloud mode: accounts, a database, chats that survive the
# browser, and the admin console. Set none of them and none of that exists.
# supabase/README.md is the twenty minutes that produces the first three.
#
# Both keys stay on the server. This app has no Supabase client in the
# browser — no SDK, no CDN, no key in a script tag.
#
# Project Settings -> API Keys. The publishable key (sb_publishable_...) goes in
# the anon line, the secret one (sb_secret_...) in the line below it; an older
# project has a Legacy API keys tab with the same pair as JWTs, and either pair
# works. Putting the secret key in the anon line is a refusal to start, because
# that key bypasses every policy in supabase/policies.sql.
COGNIX_SUPABASE_URL=
COGNIX_SUPABASE_ANON_KEY=
COGNIX_SUPABASE_SERVICE_KEY=

# Signs the session cookie. Make one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without it the server invents one per process: fine on a laptop, wrong
# anywhere with more than one instance, because two instances would reject
# each other's cookies. The server refuses to start without one when it is
# answering on anything but localhost.
COGNIX_SESSION_SECRET=

# Addresses promoted to administrator on first sign-in, comma-separated. This
# is how the first administrator exists at all — there is no other way in.
COGNIX_ADMIN_EMAILS=

# The app's own address, used to build password-reset and invitation mail.
# Wrong or missing, and those links point at Supabase's default page.
COGNIX_PUBLIC_URL=http://localhost:8778

# --------------------------------------------------------------------- limits
# All optional; the defaults are what is written here. Every one of them can
# also be changed per account, or for the whole instance, from the console.
COGNIX_TOKEN_CAP=400000        # tokens per account per month
COGNIX_MAX_CHATS=400           # chats per account
COGNIX_MAX_MSGS=400            # messages per chat
COGNIX_GW_PER_MIN=12           # model calls a minute, per account
COGNIX_LOGIN_TRIES=10          # sign-in attempts per IP...
COGNIX_LOGIN_WINDOW=900        # ...per this many seconds
COGNIX_SESSION_DAYS=30         # how long a sign-in lasts
COGNIX_SIGNUPS=1               # 0 closes the create-account form

# ---------------------------------------------------------------- the free trial
# Only meaningful in cloud mode. A visitor with no account is let straight into
# the app; their chats stay in their own browser, and they get a few model calls
# before it asks them to make an account.
#
# Read these knowing what each is worth. CHATS is what the page shows and
# enforces, and a page can be lied to. CALLS is the real one — counted in a
# cookie this server signs, so it survives a restart and cannot be edited, but
# clearing cookies starts it over. PER_IP is the backstop for that, and it is
# in-memory, so it is per instance and forgets after an hour. Together they bound
# casual use; none of them is a security boundary.
COGNIX_GUEST=1                 # 0 puts the sign-in page back in front
COGNIX_GUEST_CHATS=3           # chats the app will start without an account
COGNIX_GUEST_CALLS=9           # model calls per visitor
COGNIX_GUEST_PER_IP=40         # ...and per address per hour
COGNIX_GUEST_DAYS=7            # how long one visitor's tally lasts

# ---------------------------------------------------------------- deployment
# Cloud Run sets K_SERVICE, and these two follow it, so neither normally needs
# setting by hand.
COGNIX_TRUST_PROXY=0           # read the client IP from x-forwarded-for
COGNIX_LOG_JSON=0              # one JSON object per log line

# The one deliberate foot-gun, and it is off. Setting it lets an instance that
# holds an API key answer on a public interface with no accounts in front of
# it, which means anybody who can reach the port can spend the key.
COGNIX_ALLOW_OPEN=0
